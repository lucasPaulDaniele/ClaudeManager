{
  "name": "claudemanager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Piloter les conversations Claude de l'extension VSCode depuis un agent, sans jamais voler le focus.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:vscode": "tsc -p packages/vscode/tsconfig.build.json",
    "build:integration": "tsc -p tests/integration/tsconfig.build.json",
    "test:integration": "npm run build:vscode && npm run build:integration && node tests/integration/dist/tests/integration/src/runTests.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "~1.90.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.5"
  }
}
